{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content": "tsx scripts/build-content.ts",
    "prestart": "npm run content",
    "start": "ng serve",
    "prebuild": "npm run content",
    "build": "ng build --configuration production --base-href=/",
    "postbuild": "tsx scripts/postbuild.ts",
    "check": "npm run content && tsc -p tsconfig.app.json --noEmit",
    "validate:posts": "tsx scripts/validate-posts.ts",
    "ghpages": "angular-cli-ghpages --dir=dist/rafaelnunes-/browser --no-notfound --branch=cf-pages",
    "deploy": "npm run build && npm run ghpages",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "covers": "node scripts/generate-covers.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fortawesome/angular-fontawesome": "^1.0.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "bootstrap": "^5.3.3",
    "emailjs-com": "^3.2.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.3",
    "@angular/cli": "^19.2.3",
    "@angular/compiler-cli": "^19.2.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "angular-cli-ghpages": "^2.0.3",
    "gray-matter": "^4.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "marked": "^18.1.2",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "zod": "^4.6.7"
  }
}
